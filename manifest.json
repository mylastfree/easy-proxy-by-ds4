{
  "manifest_version": 3,
  "name": "Easy Proxy by DS4",
  "version": "2.1.0",
  "description": "一键让 Chrome 走本地代理（SOCKS5 / HTTPS），局域网默认直连，内置出口检测",
  "minimum_chrome_version": "102",
  "permissions": ["proxy", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-red.png",
      "48": "icon-red.png",
      "128": "icon-red.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icon-red.png",
    "48": "icon-red.png",
    "128": "icon-red.png"
  }
}
